[Unit]
Description=DemoHub24 Mock Banking API
After=network.target postgresql.service
[Service]
Type=simple
User=demohub24
WorkingDirectory=/opt/demohub24/mockbank/apps/api
EnvironmentFile=/etc/demohub24/mockbank.env
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/demohub24
[Install]
WantedBy=multi-user.target
